# CrisisAid Environment Variables Template
# Copy this file to ".env" and fill in your values

# Server Port
PORT=8080

# News Ingestion (NewsAPI)
NEWS_API_KEY="your-news-api-key-here"
NEWS_API_URL="https://newsapi.org/v2/everything"

# Database Configuration
# Defaults to sqlite:///instance/news.db if unset.
# For Render PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=""

# Local AI / LLM Configuration (Zero external cloud APIs required)
LOCAL_HF_MODEL="Qwen/Qwen2.5-0.5B-Instruct"

# Email & Newsletter Dispatch (Gmail SMTP)
EMAIL_USER="your-email-here@gmail.com"
EMAIL_PASSWORD="your-google-app-password"
EMAIL_PORT=465
EMAIL_SERVER="smtp.gmail.com"

# Optional: Google Custom Search API (Secondary fallback for crisis imagery if Wikimedia is unreachable)
CUSTOM_SEARCH_API_KEY=""
SEARCH_ENGINE_ID=""
CUSTOM_SEARCH_URL="https://www.googleapis.com/customsearch/v1"
